{
  "name": "paper-trading-market",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A live multiplayer paper-trading broker website: ten stocks, a host who moves prices, loans and updates.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "e2e": "node scripts/build.mjs && npx playwright test",
    "zip": "node scripts/build.mjs && node scripts/make-zip.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "10.7.13"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
