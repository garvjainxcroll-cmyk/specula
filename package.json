{
  "name": "specula",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SPECULA — live multiplayer macroeconomic trading simulation (Copia et Inopia, Round 3)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "balance": "node scripts/balance.mjs",
    "dev": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "e2e": "node scripts/build.mjs && npx playwright test",
    "zip": "node scripts/build.mjs && node scripts/make-zip.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "10.7.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
